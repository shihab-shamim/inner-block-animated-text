{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ibta/inner-block-text-animation",
  "version": "1.0.0",
  "title": "Inner Text Animator",
  "category": "widgets",
  "description": "Animate each inner text element independently with 56 entrance, loop, typing and style effects.",
  "keywords": [
    "Inner Text Animator"
  ],
  "textdomain": "inner-block-text-animation",
  "attributes": {
    "alignment": {
      "type": "string",
      "default": "center"
    },
    "container": {
      "type": "object",
      "default": {
        "background": {
          "type": "solid",
          "color": "#F1F5F9"
        },
        "padding": {
          "top": "50px",
          "right": "50px",
          "bottom": "50px",
          "left": "50px"
        },
        "margin": {
          "top": "0px",
          "right": "0px",
          "bottom": "0px",
          "left": "0px"
        },
        "radius": {
          "top": "0px",
          "right": "0px",
          "bottom": "0px",
          "left": "0px"
        },
        "border": {}
      }
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "example": {
    "attributes": {}
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./view.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}